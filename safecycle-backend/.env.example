# SafeCycle Sofia — local dev environment
# Copy to .env and fill in real values: cp .env.example .env
#
# DATABASE_URL, REDIS_URL, ENVIRONMENT and DEBUG are already set for the
# `api` service in docker-compose.yml (environment: block) and take
# precedence over whatever is set here — they're listed below only so this
# file is a complete reference of every Settings field in app/config.py.

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Security ───────────────────────────────────────────────────────────────
# Shared secret required in the `X-API-Key` header on every protected route
# (and as `?token=` on the GPS WebSocket). Empty = auth DISABLED (open) — fine
# for local dev. On a shared/hosted deploy, set a long random value as a
# platform secret (e.g. Railway service variable), NOT here. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Serve /docs, /redoc, /openapi.json. Off in production by default so the API
# schema is not public. Set true to expose docs on a shared deploy.
ENABLE_DOCS=false
# Per-client request cap (requests/minute). /health is always exempt.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ── Database (overridden by docker-compose.yml when run via compose) ────
DATABASE_URL=postgresql+asyncpg://safecycle:safecycle@localhost/safecycle

# ── Redis (overridden by docker-compose.yml when run via compose) ───────
REDIS_URL=redis://localhost:6379/0

# ── Google APIs ───────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_ROADS_API_ENABLED=true

# ── Firebase (push notifications only) ───────────────────────────────────
# Set to false to disable FCM entirely (safe no-op — no code changes needed).
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── CORS ──────────────────────────────────────────────────────────────────
# Empty = no cross-origin browser access (safe default; native apps unaffected).
# Set your web origin(s) as JSON, e.g. ["https://app.example.com"].
ALLOWED_ORIGINS=[]

# ── Safety thresholds (see README.md "Configuration" for descriptions) ──
DEFAULT_SPEED_LIMIT_KMH=50
MAX_ALLOWED_SPEED_KMH=50
DEFAULT_SURFACE=asphalt
CROSSROAD_ALERT_RADIUS_M=15.0
AWARENESS_ZONE_RADIUS_M=30.0
HAZARD_ALERT_RADIUS_M=20.0
HAZARD_TTL_SECONDS=36000
