# SafeCycle mobile — Expo public env vars.
# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app bundle
# at build time, so treat them as shipped-to-clients, not truly secret.

# Backend base URL. Local dev default shown; for the hosted backend use the
# Railway domain, e.g. https://code-for-safety-production.up.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket base URL (same host, ws/wss scheme). Defaults to ws://localhost:8000
# if unset; for the hosted backend use wss://<your-railway-domain>
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Backend API key — must match the API_KEY set on the backend. Sent as the
# X-API-Key header (REST) and ?token= (WebSocket). Leave blank against a local
# backend that has auth disabled.
EXPO_PUBLIC_API_KEY=
